# Configuração local segura. Nunca versionar o arquivo .env real.
NODE_ENV=development
PORT=3000

# Obrigatória em produção; troque por um valor forte no ambiente de deploy.
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_TTL_MS=
ADMIN_LOGIN_WINDOW_MS=

# Persistência e simulador locais.
BF_STORE_PATH=
BF_AGENT_MAX_MISUNDERSTANDINGS=3
BF_SIMULATOR_DEBUG_CONTEXT=false

# Usada exclusivamente pelo health check PostgreSQL; não migra o store JSON.
DATABASE_URL=

# DISABLED não cria provider nem faz chamadas externas (padrão recomendado).
# OPENAI_FALLBACK exige OPENAI_API_KEY e OPENAI_MODEL.
# DEEPSEEK_FALLBACK exige DEEPSEEK_API_KEY; DEEPSEEK_MODEL é opcional.
# NVIDIA_NEMOTRON exige NVIDIA_API_KEY; modelo e base URL podem ser sobrescritos.
BF_LLM_MODE=DISABLED

OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
BF_LLM_MAX_REQUESTS_PER_MINUTE=30
BF_LLM_MAX_CONCURRENT_REQUESTS=2

NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Só tem efeito com BF_LLM_MODE=NVIDIA_NEMOTRON. DISABLED (padrão) mantém a
# resposta sempre por template/fallback seguro. ENABLED liga a verbalização
# NVIDIA (chamada #2 do fluxo híbrido) — nunca escreve fato nenhum sozinha,
# só verbaliza o que allowed-facts.ts já autorizou; toda saída ainda passa
# por response-text-validator.ts antes de qualquer envio.
BF_VERBALIZATION_MODE=DISABLED

# Os scripts de smoke são manuais e podem fazer chamadas externas somente
# quando sua flag de ativação explícita estiver habilitada.
BF_LLM_LIVE_SMOKE=false
NVIDIA_NIM_MODEL=

# Integração opcional com Evolution Go 0.7.2. Defina os três valores juntos.
# O webhook oficial não oferece assinatura/HMAC compatível. Este token protege
# a URL do Brownier e deve ser usado como ?token=<segredo> no webhook configurado.
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_INSTANCE_TOKEN=
EVOLUTION_WEBHOOK_TOKEN=
