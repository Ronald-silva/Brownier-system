{
  "name": "brownies-fortal-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --experimental-strip-types server.ts",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=30000 tests/**/*.test.ts",
    "test:nim": "node scripts/test-nvidia-nim.mjs",
    "agent:simulate": "node --experimental-strip-types src/agent/simulator.ts",
    "agent:smoke:openai": "node --experimental-strip-types scripts/smoke-openai-provider.ts",
    "agent:smoke:nvidia": "node --env-file=.env --experimental-strip-types scripts/smoke-nvidia-nemotron-provider.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^5.6.24",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
